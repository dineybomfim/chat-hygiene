def load_help_text():
    if HELP_PATH.is_file():
        return HELP_PATH.read_text(encoding="utf-8")
    return (
        "# chat-hygiene\n\n"
        "HELP.md missing. Try: chat-hygiene report | check | preview | compress | expand\n"
        f"Expected guide at: {HELP_PATH}\n"
    )


def help_section(text, heading):
    lines = text.splitlines()
    needle = f"## {heading}".lower()
    start = None
    for i, line in enumerate(lines):
        stripped = line.strip().lower()
        if stripped == needle or stripped.startswith(needle + " ") or stripped.startswith(needle + "("):
            start = i
            break
    if start is None:
        return None
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if lines[j].startswith("## ") and not lines[j].startswith("### "):
            end = j
            break
    return "\n".join(lines[start:end]).rstrip() + "\n"


def cmd_help(args):
    text = load_help_text()
    topic = (getattr(args, "topic", None) or "").strip().lower()
    if not topic:
        print(text, end="" if text.endswith("\n") else "\n")
        return
    mapped = HELP_TOPICS.get(topic, topic)
    section = help_section(text, mapped)
    if section is None:
        known = ", ".join(sorted(set(HELP_TOPICS.values())))
        raise SystemExit(
            f"unknown help topic: {topic!r}\n"
            f"try: chat-hygiene help\n"
            f"topics: {known}"
        )
    print(f"# chat-hygiene help — {mapped}\n")
    print(section, end="" if section.endswith("\n") else "\n")
    print("Full guide: chat-hygiene help")


CLI_HELP_BANNER = """\
chat-hygiene — report / compress / expand oversized coding-agent chats
(Cursor, Claude Code, Codex). Python 3 stdlib only. No pip deps.

What it does
  report   ranked sizes (title + ref links)
  check    undismissed chats over threshold (folder ≥2MiB OR jsonl ≥1MiB)
  preview  dry-run from→to + snip (no changes)
  snip     sample turns to write an ultra-summary
  compress zip + manifest + summary + stub   (needs --summary INPUT)
  expand   restore original_path from zip
  dismiss  stop nudges for a chat id

Tech stack
  Language     Python 3 (argparse, pathlib, json, zipfile, re)
  Install      ~/.local/bin/chat-hygiene  →  ~/.local/share/chat-hygiene/
  Config       ~/.config/chat-hygiene/   (thresholds, dismissals)
  Backups      ~/Documents/chat-archives/<tool>/<project>/
  Summaries    ~/.local/share/chat-hygiene/summaries/

Architecture
                         ┌─────────────────────┐
                         │  You / coding agent │
                         └──────────┬──────────┘
                                    │
                         chat-hygiene <cmd>
                                    │
                                    ▼
                    ┌───────────────────────────────┐
                    │   CLI  (Python 3, stdlib)     │
                    │   ~/.local/bin/chat-hygiene   │
                    └───────────────┬───────────────┘
                                    │
              ┌─────────────────────┼─────────────────────┐
              │                     │                     │
              ▼                     ▼                     ▼
       ┌─────────────┐       ┌─────────────┐       ┌─────────────┐
       │  Discover   │       │   Config    │       │  Commands   │
       └──────┬──────┘       └──────┬──────┘       └──────┬──────┘
              │                     │                     │
              │                     ▼                     │
              │            ~/.config/chat-hygiene/        │
              │              • thresholds                 │
              │              • dismissals                 │
              │                                           │
              ▼                                           ▼
   ┌────────────────────┐              ┌──────────────────────────────┐
   │ Chat stores        │   report /   │  inspect                     │
   │                    │   check  ──► │  preview · snip              │
   │ Cursor  ~/.cursor/ │              └──────────────────────────────┘
   │ Claude  ~/.claude/ │
   │ Codex   ~/.codex/  │              ┌──────────────────────────────┐
   └─────────┬──────────┘   compress ► │  1. zip original             │
             │                         │  2. write manifest (from→to) │
             │                         │  3. write ultra-summary      │
             │                         │  4. leave tiny stub in place │
             │                         └──────────────┬───────────────┘
             │                                        │
             │                                        ▼
             │                         ~/Documents/chat-archives/
             │                           <tool>/<project>/
             │                             *.zip
             │                             *.manifest.json
             │                                        │
             │◄────────────── expand ─────────────────┘
             │              (restore original_path)
             │
             ▼
   ~/.local/share/chat-hygiene/summaries/
     <tool>/<project>/<id>.md


   Thin wrappers (not core runtime)
   ────────────────────────────────
   HELP.md · skill · adapters · shell completions · templates

Full narrative guide:  chat-hygiene help
"""


class CliHelpParser(argparse.ArgumentParser):
    def print_help(self, file=None):
        file = sys.stdout if file is None else file
        file.write(CLI_HELP_BANNER)
        if not CLI_HELP_BANNER.endswith("\n"):
            file.write("\n")
        file.write("\n")
        super().print_help(file)


def build_parser():
    p = CliHelpParser(
        prog="chat-hygiene",
        description="Report and compress oversized coding-agent chats.",
        epilog="Examples:  chat-hygiene help  |  chat-hygiene report  |  chat-hygiene preview --top 3",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="cmd", required=False)

    h = sub.add_parser(
        "help",
        aliases=["h", "doc", "docs"],
        help="Full guide with examples (try: chat-hygiene help compress)",
    )
    h.add_argument(
        "topic",
        nargs="?",
        default=None,
        help="Optional topic: report, compress, expand, examples, naming, …",
    )
    h.set_defaults(func=cmd_help)

    r = sub.add_parser("report", aliases=["r"], help="Rank chats by size")
    r.add_argument("path", nargs="?", default=None)
    r.add_argument("--all", action="store_true", help="All discovered projects")
    r.add_argument("--all-rows", action="store_true", help="Print every chat, not only top_n")
    r.set_defaults(func=cmd_report)

    c = sub.add_parser("check", aliases=["c"], help="List undismissed chats over threshold")
    c.add_argument("path", nargs="?", default=None)
    c.add_argument("--all", action="store_true")
    c.set_defaults(func=lambda a: sys.exit(cmd_check(a)))

    d = sub.add_parser("dismiss", aliases=["d"], help="Never nudge these chat id(s) again")
    add_target_args(d)
    d.set_defaults(func=cmd_dismiss)

    und = sub.add_parser("undismiss", aliases=["ud"], help="Clear dismissal(s)")
    add_target_args(und)
    und.set_defaults(func=cmd_undismiss)

    sn = sub.add_parser(
        "snip",
        aliases=["x", "sample", "extract"],
        help="Sample head/tail turns (to write a summary). Not unzip.",
    )
    add_target_args(sn)
    sn.set_defaults(func=cmd_snip)

    prev = sub.add_parser(
        "preview",
        aliases=["p", "dry-run"],
        help="Dry-run: show from→to paths + snip; does NOT compress",
    )
    add_target_args(prev)
    prev.set_defaults(func=cmd_preview)

    sel = sub.add_parser("select", aliases=["s"], help="Print selected ids (for scripts/batches)")
    add_target_args(sel)
    sel.set_defaults(func=cmd_select)

    z = sub.add_parser(
        "compress",
        aliases=["zip", "z", "compact"],
        help="Zip chat to archive, write summary, replace with stub. Needs --summary INPUT.",
    )
    add_target_args(z)
    z.add_argument(
        "--summary",
        help="INPUT path to one ultra-squeeze .md (single chat). Not a dry-run flag.",
    )
    z.add_argument(
        "--summary-dir",
        help="INPUT directory with <chat-id>.md files (batch / --top / --rank)",
    )
    z.set_defaults(func=cmd_compress)

    ex = sub.add_parser(
        "expand",
        aliases=["unzip", "restore"],
        help="Restore a chat from zip to its original path (uses manifest)",
    )
    ex.add_argument("chat_id", nargs="?", default=None, help="Optional; used to verify zip or legacy restore")
    ex.add_argument("--zip", required=True, help="Backup zip path")
    ex.add_argument("--path", default=None, help="Project path for legacy lookup")
    ex.set_defaults(func=cmd_expand)

    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "cmd", None):
        cmd_help(argparse.Namespace(topic=None))
        return
    args.func(args)


if __name__ == "__main__":
    main()


